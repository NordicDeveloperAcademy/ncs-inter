/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;

&cpuapp_rram {
    partitions {
        boot_partition: partition@0 {
            compatible = "zephyr,mapped-partition";
            label = "mcuboot";
            reg = <0x0 DT_SIZE_K(100)>;
        };

        slot0_partition: partition@19000 {
            compatible = "zephyr,mapped-partition";
            label = "image-0";
            reg = <0x19000 DT_SIZE_K(800)>;
        };

        slot1_partition: partition@e1000 {
            compatible = "zephyr,mapped-partition";
            label = "image-1";
            reg = <0xe1000 DT_SIZE_K(800)>;
        };
    };
};

/* CDC ACM for mcumgr (from app.overlay) */
/* STEP 5.2 - Choose CDC ACM for mcumgr */
/ {
    chosen {
        zephyr,uart-mcumgr = &cdc_acm_uart0;
    };
};

/* STEP 5.1 - Configure CDC ACM */
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};
