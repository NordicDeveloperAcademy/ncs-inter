/delete-node/ &slot1_partition;

&boot_partition {
	reg = <0x00000000 0x19000>;
};

&slot0_partition {
	reg = <0x00019000 0xd7000>;
	ranges = <0x0 0x19000 0xd7000>;
};

&slot0_s_partition {
	reg = <0x0 0x7b000>;
};

&slot0_ns_partition {
	reg = <0x7b000 0x5c000>;
};

&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot1_partition: partition@0 {
			compatible = "fixed-subpartitions";
			label = "image-1";
			reg = <0x00000 0xd7000>;
			#address-cells = <1>;
			#size-cells = <1>;

			slot1_s_partition: partition@0 {
				label = "image-1-secure";
				reg = <0x0 0x7b000>;
			};

			slot1_ns_partition: partition@7b000 {
				label = "image-1-nonsecure";
				reg = <0x7b000 0x5c000>;
			};
		};
	};
};

/ {
	chosen {
		zephyr,uart-mcumgr = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
